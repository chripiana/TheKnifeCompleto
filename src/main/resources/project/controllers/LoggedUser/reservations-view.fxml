<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="project.controllers.ReservationsController"
            stylesheets="@../style.css" styleClass="modern-page">

    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" prefHeight="64">
            <padding><Insets left="60" right="60"/></padding>
            <HBox alignment="CENTER_LEFT" onMouseClicked="#handleGoToHome" style="-fx-cursor: hand;">
                <Text text="The" style="-fx-font-family: 'Playfair Display'; -fx-font-size: 26; -fx-font-weight: bold; -fx-fill: white;"/>
                <Text text="Knife" style="-fx-font-family: 'Playfair Display'; -fx-font-size: 26; -fx-font-weight: bold; -fx-fill: #74C69D;"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#handleGoToProfile"
                    style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
                <graphic>
                    <StackPane>
                        <Circle radius="20" fill="white" stroke="#B7E4C7" strokeWidth="1" />
                        <SVGPath content="M12,2C14.2,2 16,3.8 16,6C16,8.2 14.2,10 12,10C9.8,10 8,8.2 8,6C8,3.8 9.8,2 12,2M12,12C7.6,12 4,13.8 4,16V18H20V16C20,13.8 16.4,12 12,12Z"
                                 fill="#4A6B57" scaleX="1.1" scaleY="1.1"/>
                    </StackPane>
                </graphic>
            </Button>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 28 60 40 60; -fx-background-color: linear-gradient(to bottom, #f5faf6 0%, #f7f9fa 100%);">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="📅" style="-fx-font-size: 28px;"/>
                <Label text="Le mie prenotazioni" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1B4332;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Aggiorna" onAction="#handleRefresh" styleClass="btn-primary"/>
            </HBox>

            <HBox spacing="20" VBox.vgrow="ALWAYS">
                <VBox spacing="12" prefWidth="520" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #E6EFEA; -fx-border-width: 1; -fx-border-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(27,67,50,0.06), 12, 0, 0, 4);">
                    <Label text="Prenotazioni salvate" styleClass="section-title"/>
                    <ListView fx:id="reservationsListView" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 4;"/>
                </VBox>

                <VBox spacing="18" prefWidth="520" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-background-radius: 18; -fx-border-color: #E6EFEA; -fx-border-width: 1; -fx-border-radius: 18; -fx-padding: 18; -fx-effect: dropshadow(three-pass-box, rgba(27,67,50,0.06), 12, 0, 0, 4);">
                    <Label text="Modifica prenotazione" styleClass="section-title"/>

                    <GridPane hgap="12" vgap="12">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <Label text="Data" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #4A6B57;"/>
                        <DatePicker fx:id="reservationDatePicker" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="home-text-field"/>

                        <Label text="Ora" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #4A6B57;"/>
                        <ComboBox fx:id="reservationTimeCombo" GridPane.rowIndex="1" GridPane.columnIndex="1" maxWidth="Infinity" styleClass="home-text-field"/>

                        <Label text="Persone" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #4A6B57;"/>
                        <Spinner fx:id="reservationGuestsSpinner" GridPane.rowIndex="2" GridPane.columnIndex="1" editable="true" maxWidth="Infinity"/>

                        <Label text="Note" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #4A6B57;"/>
                        <TextArea fx:id="reservationNotesArea" prefRowCount="5" wrapText="true"
                                  GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="modern-textarea"/>
                    </GridPane>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button fx:id="deleteReservationButton" text="Cancella" onAction="#handleDeleteReservation" style="-fx-background-color: #FEE2E2; -fx-text-fill: #DC2626; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 10; -fx-padding: 10 16;"/>
                        <Button fx:id="saveReservationButton" text="Salva modifiche" onAction="#handleSaveReservation" styleClass="btn-primary"/>
                    </HBox>

                    <Label fx:id="reservationStatusLabel" wrapText="true" style="-fx-font-weight: bold; -fx-padding: 6 0 0 0; -fx-text-fill: #2E7D32;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
